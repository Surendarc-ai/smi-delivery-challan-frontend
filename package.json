    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@vitejs/plugin-vue": "^5.0.3",
    "vite": "^5.0.11"
